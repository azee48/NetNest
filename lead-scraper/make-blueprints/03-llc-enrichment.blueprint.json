{
    "name": "NetNest 03 | LLC Owner Enrichment (hourly)",
    "flow": [
        {
            "id": 1,
            "module": "util:SetVariables",
            "version": 1,
            "parameters": {},
            "mapper": {
                "variables": [
                    {
                        "name": "CFG_OPENCORPORATES_TOKEN",
                        "value": "PASTE_YOUR_OPENCORPORATES_API_TOKEN_HERE"
                    },
                    {
                        "name": "CFG_OC_SEARCH_URL",
                        "value": "https://api.opencorporates.com/v0.4/companies/search"
                    },
                    {
                        "name": "CFG_JURISDICTION",
                        "value": "us_ca"
                    }
                ],
                "scope": "roundtrip"
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "CONFIG — edit me"
                },
                "notes": "OpenCorporates covers CA SOS registrations (LLC/corp name, status, registered agent, addresses, officers). For the official state source, register at calicodev.sos.ca.gov (CA SOS Calico API) and swap the URL + add your Ocp-Apim-Subscription-Key header in modules 3-4. Bulk option: CA SOS 'Master Unload' file - see docs/data-sources.md."
            }
        },
        {
            "id": 2,
            "module": "google-sheets:searchRows",
            "version": 2,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "",
                "sheetId": "Leads",
                "includesHeaders": true,
                "filter": [
                    [
                        {
                            "a": "owner_name_raw",
                            "o": "text:contain:ci",
                            "b": "LLC"
                        },
                        {
                            "a": "llc_agent_name",
                            "o": "notexist"
                        }
                    ]
                ],
                "sortOrder": "asc",
                "orderBy": "",
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING",
                "limit": "20"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0,
                    "name": "Find un-enriched LLC owners"
                },
                "notes": "After import: attach Google connection + master spreadsheet. Add OR-groups to the filter for 'TRUST', 'INC', 'CORP', 'LP' to catch all entity owners. Limit 20/run keeps you inside OpenCorporates free-tier rate limits."
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "{{1.CFG_OC_SEARCH_URL}}",
                "method": "get",
                "headers": [],
                "qs": [
                    {
                        "name": "q",
                        "value": "{{2.owner_name_raw}}"
                    },
                    {
                        "name": "jurisdiction_code",
                        "value": "{{1.CFG_JURISDICTION}}"
                    },
                    {
                        "name": "order",
                        "value": "score"
                    },
                    {
                        "name": "api_token",
                        "value": "{{1.CFG_OPENCORPORATES_TOKEN}}"
                    }
                ],
                "bodyType": "",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0,
                    "name": "Search CA registry (OpenCorporates)"
                }
            }
        },
        {
            "id": 4,
            "module": "http:ActionSendData",
            "version": 3,
            "filter": {
                "name": "Match found",
                "conditions": [
                    [
                        {
                            "a": "{{3.data.results.companies[1].company.company_number}}",
                            "o": "exist"
                        }
                    ]
                ]
            },
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://api.opencorporates.com/v0.4/companies/{{1.CFG_JURISDICTION}}/{{3.data.results.companies[1].company.company_number}}",
                "method": "get",
                "headers": [],
                "qs": [
                    {
                        "name": "api_token",
                        "value": "{{1.CFG_OPENCORPORATES_TOKEN}}"
                    }
                ],
                "bodyType": "",
                "parseResponse": true,
                "authUser": "",
                "authPass": "",
                "timeout": "30",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "followAllRedirects": false
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0,
                    "name": "Get company detail (agent + officers)"
                },
                "notes": "Detail response includes registered agent (agent_name/agent_address), registered address, and officers[] (managers/members for LLCs). Officers are the actual people to contact."
            }
        },
        {
            "id": 5,
            "module": "google-sheets:updateRow",
            "version": 2,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "from": "drive",
                "mode": "select",
                "spreadsheetId": "",
                "sheetId": "Leads",
                "includesHeaders": true,
                "rowNumber": "{{2.__ROW_NUMBER__}}",
                "valueInputOption": "USER_ENTERED",
                "values": {
                    "8": "true",
                    "9": "{{3.data.results.companies[1].company.name}}",
                    "10": "{{ifempty(4.data.results.company.agent_name; 4.data.results.company.officers[1].officer.name)}}",
                    "11": "{{ifempty(4.data.results.company.agent_address; 4.data.results.company.registered_address_in_full)}}",
                    "39": "enriched"
                }
            },
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 0,
                    "name": "Write LLC details back to sheet"
                },
                "notes": "Columns: 8=is_llc, 9=llc_name, 10=llc_agent_name, 11=llc_agent_address, 39=status. Row number comes from the search module."
            }
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": true,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us1.make.com",
        "notes": [
            "SCHEDULE: hourly. Processes up to 20 LLC rows per run.",
            "LLC-owned properties are usually investors, not first-time buyers - this enrichment matters most for solar leads (commercial/portfolio owners) and for filtering LLC noise out of your FTHB list.",
            "For the official California source, swap OpenCorporates for the CA SOS Calico API (calicodev.sos.ca.gov, free registration + subscription key)."
        ]
    }
}
